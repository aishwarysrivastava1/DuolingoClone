# Copy to backend/.env for local development. It is loaded automatically;
# real environment variables take precedence. Never commit backend/.env.

# Turso (cloud SQLite / libSQL). Leave both empty to use the local SQLite file.
#   TURSO_DATABASE_URL:  turso db show <database> --url        (libsql://<db>-<org>.turso.io)
#   TURSO_AUTH_TOKEN:    turso db tokens create <database>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite file used when Turso isn't configured (default: backend/data/duolingo.db)
# DATABASE_PATH=

# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HEART_REGEN_MINUTES=30
